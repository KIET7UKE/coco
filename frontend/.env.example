# Accounts, orders, Stripe checkout + webhook and email all live in backend/.
# Stripe, SMTP, MongoDB and JWT secrets go in backend/.env, never here.
# Requests to /api are forwarded to the backend by the Vite dev proxy (port 5001)
# and, in production, by the rewrite in vercel.json.
#
# Everything below is VITE_ and ships to the browser, so it must not be secret.

# Hibarri API. Powers Superadmin > Coco: analytics, form submissions, admin-uploaded
# videos and CMS pages at /page/<slug>. Leave empty to run the site standalone.
VITE_API_URL=https://api.hibarri.com/api
# Optional override for form submissions (defaults to <VITE_API_URL>/coco/leads).
VITE_LEADS_ENDPOINT=
# Microsoft Clarity project id.
VITE_CLARITY_ID=

# Sanity blog. The project id is public.
VITE_SANITY_PROJECT_ID=qnyzl4ai
VITE_SANITY_DATASET=production

# Fallback broadcast media. Videos marked active in Superadmin > Coco > Videos take priority.
VITE_BROADCAST_VIDEO_URL=
VITE_BROADCAST_PREVIEW_URL=
VITE_BROADCAST_POSTER_URL=
VITE_BROADCAST_DURATION_MIN=75
VITE_WHITEPAPER_URL=

# Wire transfer details shown after a wire order.
VITE_BANK_ACCOUNT_NAME=
VITE_BANK_NAME=
VITE_BANK_ACCOUNT=
VITE_BANK_SWIFT=
