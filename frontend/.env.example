# The frontend talks to two backends:
#
# 1. Coco backend (backend/, hosted on Railway): login, register, dashboard, orders,
#    checkout, email, store. Always called as same-origin /api/... so the login cookie
#    stays first-party. The Vite dev proxy forwards /api to port 5001; on Vercel,
#    middleware.js forwards it to COCO_BACKEND_URL. Set COCO_BACKEND_URL in the Vercel
#    project (e.g. https://coco-production-79bd.up.railway.app), not here: it is read
#    server-side and is not a VITE_ variable. Never point the browser at Railway directly.
#
# 2. Hibarri API (api.hibarri.com): analytics, form submissions, admin-uploaded videos and
#    CMS pages at /page/<slug>. Called cross-origin without cookies, set below.
#
# Stripe, SMTP, MongoDB and JWT secrets go in backend/.env, never here.
# Everything below is VITE_ and ships to the browser, so it must not be secret.
# VITE_ values are baked in at build time: redeploy after changing them on Vercel.

# Hibarri API base URL. Leave empty to run the site standalone.
VITE_HIBARRI_API_URL=https://api.hibarri.com/api
# Optional override for form submissions (defaults to <VITE_HIBARRI_API_URL>/coco/leads).
VITE_LEADS_ENDPOINT=
# Microsoft Clarity project id.
VITE_CLARITY_ID=

# Sanity blog. The project id is public.
VITE_SANITY_PROJECT_ID=qnyzl4ai
VITE_SANITY_DATASET=production

# Fallback broadcast media. Videos marked active in Superadmin > Coco > Videos take priority.
VITE_BROADCAST_VIDEO_URL=
VITE_BROADCAST_PREVIEW_URL=
VITE_BROADCAST_POSTER_URL=
VITE_BROADCAST_DURATION_MIN=75
VITE_WHITEPAPER_URL=

# Wire transfer details shown after a wire order.
VITE_BANK_ACCOUNT_NAME=
VITE_BANK_NAME=
VITE_BANK_ACCOUNT=
VITE_BANK_SWIFT=
