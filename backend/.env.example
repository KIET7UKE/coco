PORT=5001
NODE_ENV=development

# Required. Your existing MongoDB (Atlas) connection string; the server refuses to start without it.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/coco?retryWrites=true&w=majority

# Required. Long random string (32+ chars in production), e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Stripe (required in production). Webhook endpoint: https://<your-site>/api/webhook/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public site URL(s), comma-separated. The first one is used for Stripe return links and email links.
CLIENT_URL=http://localhost:5173

# Number of proxies in front of the backend, so rate limits see the visitor's IP, not a proxy's.
# 2 = Vercel rewrite + your host's load balancer (Render, Railway, Fly...). 1 = only the host's load balancer.
TRUST_PROXY=2

# Paid orders are forwarded here (Hibarri Superadmin > Coco > Forms).
LEADS_ENDPOINT=https://api.hibarri.com/api/coco/leads

# Transactional email sent by /api/email (broadcast seat confirmation, white paper).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=coco@hibarri.com
SMTP_PASS=
EMAIL_FROM="CoCo by Hibarri <coco@hibarri.com>"
EMAIL_REPLY_TO=
BROADCAST_TITLE=Real Estate vs Digital Estate
BROADCAST_DURATION_MIN=75
WHITEPAPER_URL=
